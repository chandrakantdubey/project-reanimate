{
  "name": "project-reanimate",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.19.0",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @reanimate/db db:generate",
    "db:migrate": "pnpm --filter @reanimate/db db:migrate",
    "preflight": "node scripts/preflight.mjs",
    "bootstrap": "node scripts/bootstrap-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
